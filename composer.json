{
  "name": "chamber-orchestra/doctrine-extensions-bundle",
  "type": "symfony-bundle",
  "description": "Lightweight Symfony Doctrine ORM extensions for PostgreSQL — entity traits, soft-delete filter, repository base classes, decimal type, random() DQL",
  "keywords": [
    "symfony",
    "symfony-bundle",
    "doctrine",
    "doctrine-orm",
    "doctrine-extensions",
    "postgresql",
    "soft-delete",
    "entity-traits",
    "uuid",
    "repository",
    "dql"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Andrew Lukin",
      "email": "lukin.andrej@gmail.com",
      "homepage": "https://github.com/wtorsi",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.5",
    "symfony/dependency-injection": "8.2.*",
    "symfony/config": "8.2.*",
    "symfony/framework-bundle": "8.2.*",
    "symfony/runtime": "8.2.*",
    "symfony/clock": "8.2.*",
    "symfony/uid": "8.2.*",
    "doctrine/orm": "3.8.*",
    "doctrine/doctrine-bundle": "3.4.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "symfony/test-pack": "^1.2",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "ChamberOrchestra\\DoctrineExtensionsBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "beta",
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.2.*"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "analyse": "vendor/bin/phpstan analyse",
    "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs-fix": "vendor/bin/php-cs-fixer fix"
  },
  "prefer-stable": true
}
